<div class="mx-auto flex min-h-[calc(100vh-12rem)] max-w-4xl items-center justify-center px-4">
  <section class="w-full text-center">
    <div class="mx-auto mb-10 max-w-2xl">
      <p class="mb-3 text-xl font-semibold tracking-tight text-[#e6edf3]">PolyScope</p>
      <p class="text-sm text-[#9ca3af]">Analyze resolution risk for any prediction market</p>
    </div>

    <div id="hero_live_search" class="relative mx-auto w-full max-w-3xl">
      <div class="rounded-2xl border border-white/10 bg-[#111827]/80 shadow-[0_0_0_1px_rgba(59,130,246,0.08),0_12px_40px_rgba(0,0,0,0.45)] backdrop-blur">
        <div class="relative">
          <svg class="pointer-events-none absolute left-5 top-1/2 h-5 w-5 -translate-y-1/2 text-[#94a3b8]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <input
            id="hero_live_search_input"
            type="text"
            autocomplete="off"
            placeholder="Search any prediction market..."
            class="w-full rounded-2xl border-0 bg-transparent py-5 pl-14 pr-5 text-base text-[#e6edf3] placeholder:text-[#64748b] focus:outline-none focus:ring-2 focus:ring-[#3b82f6]/50"
            aria-label="Search prediction markets"
            aria-controls="hero_live_search_results"
            aria-expanded="false"
          >
        </div>
      </div>

      <div
        id="hero_live_search_results"
        class="pointer-events-none absolute left-0 right-0 top-[calc(100%+0.75rem)] z-50 max-h-0 overflow-hidden rounded-xl border border-transparent bg-[#0f172a]/95 opacity-0 shadow-2xl shadow-black/60 transition-all duration-200"
        aria-hidden="true"
      >
        <div id="hero_live_search_frame">
          <div class="px-5 py-4 text-sm text-[#94a3b8]">Start typing to search markets</div>
        </div>
      </div>
    </div>
  </section>
</div>

<script>
  (function() {
    function initHeroSearch() {
      var wrapper = document.getElementById("hero_live_search");
      var input = document.getElementById("hero_live_search_input");
      var panel = document.getElementById("hero_live_search_results");
      var frame = document.getElementById("hero_live_search_frame");
      if (!wrapper || !input || !panel || !frame) return;
      if (wrapper.dataset.bound === "true") return;
      wrapper.dataset.bound = "true";

      var timer;
      var requestNonce = 0;

      function openPanel() {
        panel.classList.remove("pointer-events-none", "max-h-0", "opacity-0", "border-transparent");
        panel.classList.add("pointer-events-auto", "max-h-[28rem]", "opacity-100", "border-white/10");
        input.setAttribute("aria-expanded", "true");
        panel.setAttribute("aria-hidden", "false");
      }

      function closePanel() {
        panel.classList.add("pointer-events-none", "max-h-0", "opacity-0", "border-transparent");
        panel.classList.remove("pointer-events-auto", "max-h-[28rem]", "opacity-100", "border-white/10");
        input.setAttribute("aria-expanded", "false");
        panel.setAttribute("aria-hidden", "true");
      }

      function updateSearch() {
        var q = input.value.trim();
        if (!q) {
          closePanel();
          frame.innerHTML = '<div class="px-5 py-4 text-sm text-[#94a3b8]">Start typing to search markets</div>';
          return;
        }

        openPanel();
        requestNonce += 1;
        var nonce = requestNonce;
        var url = "<%= live_search_markets_path %>?q=" + encodeURIComponent(q);
        fetch(url, { headers: { "Accept": "text/html" } })
          .then(function(response) { return response.text(); })
          .then(function(html) {
            if (nonce !== requestNonce) return;
            frame.innerHTML = html;
            openPanel();
          })
          .catch(function() {
            if (nonce !== requestNonce) return;
            frame.innerHTML = '<div class="px-5 py-4 text-sm text-[#94a3b8]">Search failed. Try again.</div>';
          });
      }

      input.addEventListener("input", function() {
        clearTimeout(timer);
        timer = setTimeout(updateSearch, 500);
      });

      input.addEventListener("focus", function() {
        if (input.value.trim().length > 0) openPanel();
      });

      if (!document._polySearchDocBound) {
        document._polySearchDocBound = true;
        document.addEventListener("click", function(e) {
          var w = document.getElementById("hero_live_search");
          if (w && !w.contains(e.target)) {
            var p = document.getElementById("hero_live_search_results");
            var i = document.getElementById("hero_live_search_input");
            if (p) {
              p.classList.add("pointer-events-none", "max-h-0", "opacity-0", "border-transparent");
              p.classList.remove("pointer-events-auto", "max-h-[28rem]", "opacity-100", "border-white/10");
              p.setAttribute("aria-hidden", "true");
            }
            if (i) i.setAttribute("aria-expanded", "false");
          }
        });
        document.addEventListener("keydown", function(e) {
          if (e.key === "Escape") {
            var p = document.getElementById("hero_live_search_results");
            var i = document.getElementById("hero_live_search_input");
            if (p) {
              p.classList.add("pointer-events-none", "max-h-0", "opacity-0", "border-transparent");
              p.classList.remove("pointer-events-auto", "max-h-[28rem]", "opacity-100", "border-white/10");
              p.setAttribute("aria-hidden", "true");
            }
            if (i) i.setAttribute("aria-expanded", "false");
          }
        });
      }
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initHeroSearch);
    } else {
      initHeroSearch();
    }
    document.addEventListener("turbo:load", initHeroSearch);
  })();
</script>
