<% volume = market.respond_to?(:volume) ? market.volume : nil %>
<% volume_label = if volume.present?
  v = volume.to_f
  if v >= 1_000_000
    "$#{format('%.1f', v / 1_000_000)}M"
  elsif v >= 1_000
    "$#{format('%.0f', v / 1_000)}K"
  else
    "$#{v.to_i}"
  end
else
  "—"
end %>
<% end_date_label = if market.respond_to?(:end_date) && market.end_date.present?
  market.end_date.strftime("%b %d")
else
  "—"
end %>

<a href="#"
   class="flex items-center gap-3 border-b border-white/5 px-4 py-3 text-left transition-colors duration-150 last:border-b-0 hover:bg-white/5"
   role="option">
  <div class="flex h-10 w-10 shrink-0 items-center justify-center overflow-hidden rounded-md bg-[#1f2937]">
    <% if market.respond_to?(:event_image) && market.event_image.present? %>
      <%= image_tag market.event_image, alt: "", class: "h-10 w-10 object-cover", loading: "lazy" %>
    <% else %>
      <svg class="h-4 w-4 text-[#94a3b8]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
      </svg>
    <% end %>
  </div>

  <div class="min-w-0 flex-1">
    <p class="line-clamp-2 text-sm font-medium text-[#e5e7eb]"><%= market.respond_to?(:event_question) ? market.event_question : "Market" %></p>
    <div class="mt-1 flex items-center gap-2 text-xs text-[#94a3b8]">
      <span class="rounded-full border border-white/10 px-2 py-0.5"><%= market.respond_to?(:category) && market.category.present? ? market.category : "Uncategorized" %></span>
      <span><%= volume_label %> Vol.</span>
      <span>Ends <%= end_date_label %></span>
    </div>
  </div>
</a>
