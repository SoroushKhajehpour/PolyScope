<%# No meta refresh: score updates via Turbo Stream + fetch fallback; full reload would pollute history and break Back button. %>

<div class="mx-auto flex min-h-[calc(100vh-12rem)] max-w-5xl items-center justify-center px-4">
  <%= turbo_stream_from "market_#{@market.id}_score" %>
  <section id="risk_score_result" class="w-full max-w-2xl rounded-2xl border border-white/10 bg-[#111827]/80 px-8 py-10 text-center shadow-2xl shadow-black/60">
    <div class="mb-6 rounded-lg border border-white/10 bg-[#0b1220]/80 p-4 text-left">
      <div class="flex items-start gap-3">
        <div class="h-12 w-12 shrink-0 overflow-hidden rounded-md border border-white/10 bg-[#1f2937]">
          <% if @market.event_image.present? %>
            <%= image_tag @market.event_image, alt: "Market image", class: "h-full w-full object-cover", loading: "lazy" %>
          <% else %>
            <div class="flex h-full w-full items-center justify-center text-[10px] text-[#94a3b8]">No image</div>
          <% end %>
        </div>
        <div class="min-w-0 flex-1">
          <p class="text-xs uppercase tracking-wider text-[#94a3b8]"><%= @market.category.presence || "Uncategorized" %></p>
          <p class="mt-1 text-sm font-medium leading-snug text-[#e5e7eb]"><%= @market.event_question.presence || "Market ##{@market.event_id}" %></p>
          <p class="mt-2 text-xs text-[#94a3b8]"><%= @market.resolution_criteria.presence || "No resolution criteria provided." %></p>
        </div>
      </div>
    </div>
    <div class="mx-auto mb-6 h-16 w-16 rounded-full border-4 border-[#334155] border-t-[#3b82f6] animate-spin"></div>
    <h1 class="mb-4 text-2xl font-semibold text-[#e5e7eb]">Evaluating Risk</h1>
    <div class="relative mx-auto h-7 w-full max-w-sm overflow-hidden">
      <p class="loading-step absolute inset-0 text-[#94a3b8]">Fetching market data...</p>
      <p class="loading-step absolute inset-0 text-[#94a3b8]" style="animation-delay: 1.5s;">Running ambiguity analysis...</p>
      <p class="loading-step absolute inset-0 text-[#94a3b8]" style="animation-delay: 3s;">Scoring resolution risk...</p>
      <p class="loading-step absolute inset-0 text-[#94a3b8]" style="animation-delay: 4.5s;">Finalizing report...</p>
    </div>
  </section>
</div>

<style>
  @keyframes stepFade {
    0% { opacity: 0; transform: translateY(8px); }
    8% { opacity: 1; transform: translateY(0); }
    22% { opacity: 1; transform: translateY(0); }
    30% { opacity: 0; transform: translateY(-8px); }
    100% { opacity: 0; transform: translateY(-8px); }
  }

  .loading-step {
    opacity: 0;
    animation: stepFade 6s infinite;
  }
</style>

<script>
  (function() {
    var pollTimer = null;
    function hydrateIfScoreReady() {
      var container = document.getElementById("risk_score_result");
      if (!container) return;
      fetch(window.location.pathname + "/score_result", { headers: { "Accept": "text/html" } })
        .then(function(response) {
          if (response.status === 204) return null;
          if (!response.ok) return null;
          return response.text();
        })
        .then(function(html) {
          if (!html) return;
          container.innerHTML = html;
          if (pollTimer) { clearInterval(pollTimer); pollTimer = null; }
        });
    }
    function startPolling() {
      if (pollTimer) return;
      pollTimer = setInterval(hydrateIfScoreReady, 8000);
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", function() { hydrateIfScoreReady(); startPolling(); });
    } else {
      hydrateIfScoreReady();
      startPolling();
    }
    document.addEventListener("turbo:load", function() { hydrateIfScoreReady(); startPolling(); });
  })();
</script>
