<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "PolyScope" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/icon.png">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

    <%= vite_client_tag %>
    <%= vite_react_refresh_tag %>
    <%= vite_javascript_tag "entrypoints/application.tsx" %>

    <%= yield :head %>
  </head>

  <body>
    <%= yield %>

    <% if Rails.env.development? && ENV["SHOW_API_DIAGNOSTICS"] == "true" %>
      <div id="dev_api_diagnostics_overlay" style="position:fixed;right:12px;bottom:12px;z-index:9999;max-width:340px;background:rgba(15,23,42,.95);color:#e2e8f0;border:1px solid rgba(148,163,184,.25);border-radius:10px;padding:12px;font-size:11px;line-height:1.4;font-family:ui-monospace, SFMono-Regular, Menlo, monospace;">
        Loading API diagnostics...
      </div>
      <script>
        (function() {
          function sectionHtml(title, s) {
            if (!s) return "<strong>" + title + "</strong><br>Calls: 0<br>";
            var lines = ["<strong>" + title + "</strong>", "Calls: " + (s.calls || 0), "Cache: " + (s.cache_hit_rate != null ? s.cache_hit_rate + "%" : "\u2014")];
            if (s.rate_limit && (s.rate_limit.usage_pct != null || s.rate_limit.remaining != null)) {
              if (s.rate_limit.usage_pct != null) lines.push("Usage: " + s.rate_limit.usage_pct + "%");
              if (s.rate_limit.remaining != null) lines.push("Remaining: " + s.rate_limit.remaining);
            }
            return lines.join("<br>") + "<br>";
          }
          function renderDiag(data) {
            var el = document.getElementById("dev_api_diagnostics_overlay");
            if (!el) return;
            var html = "<strong>API Diagnostics</strong><br>";
            html += sectionHtml("OpenAI", data.openai);
            html += sectionHtml("Anthropic", data.anthropic);
            html += "\u2014<br>Total calls: " + (data.total_calls || 0) + " &middot; Deduped: " + (data.deduped_calls || 0);
            el.innerHTML = html;
          }
          function poll() {
            fetch("/dev/api_diagnostics", { headers: { "Accept": "application/json" } })
              .then(function(r) { return r.json(); })
              .then(renderDiag)
              .catch(function() {});
          }
          poll();
          setInterval(poll, 4000);
        })();
      </script>
    <% end %>
  </body>
</html>
